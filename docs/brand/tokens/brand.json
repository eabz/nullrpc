  "notes": {
    "border": "Decorative separators only. Use border-strong for the visible boundary of an input or other control.",
    "button": "Dark mode separates accent (Signal, for text and marks) from button-bg (Cobalt, carrying white text). Light mode uses Deep signal for both.",
    "focus": "Use a 2px outline and 3px offset against a theme surface; do not place the ring directly on the same accent color.",
    "chart": "Use labels and distinct markers or line styles; chart-to-chart contrast is not guaranteed.",
    "surface-raised": "White in light mode; separate adjacent white surfaces with spacing or a decorative border.",
    "radius": "Corners are tight by design: 2px for inputs and chips, 4px for buttons and cards, 6px maximum for large panels."
  }
