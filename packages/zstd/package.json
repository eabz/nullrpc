{
  "name": "@nullrpc/zstd",
  "private": true,
  "type": "module",
  "description": "zstd frame decompression in WebAssembly (the C library) for the RPC Worker's archive reads, with fzstd as the fallback when the module cannot be instantiated",
  "exports": {
    ".": "./src/index.ts",
    "./test/vitest-wasm": "./test/vitest-wasm.ts"
  },
  "scripts": {
    "build": "sh scripts/build.sh",
    "typecheck": "tsc --noEmit",
    "test": "sh scripts/build.sh && vitest run"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
