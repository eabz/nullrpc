{
  "name": "nullrpc-rpc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../../packages/executor build && bun run --cwd ../../packages/frames build",
    "dev": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "node test/fixtures/fetch.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "@nullrpc/executor": "workspace:*",
    "@nullrpc/frames": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.148.0"
  }
}
