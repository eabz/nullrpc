{
  "_comment": "Credits per JSON-RPC call. Single source of truth: compiled into the RPC Worker and imported by the platform (apps/app). Weights follow measured cost: Workers request fee + CPU per method, R2 reads, and live state calls (eth_call/estimateGas make ~5 state reads on a cache miss). A typical call is about 20 credits; debug/trace calls 2x and replays 4x a typical call, mirroring QuickNode's multipliers. A batch item costs its method's credits.",
  "default": 20,
  "invalid": 5,
  "methods": {
    "eth_chainId": 5,
    "net_version": 5,
    "net_listening": 5,
    "net_peerCount": 5,
    "web3_clientVersion": 5,
    "web3_sha3": 5,
    "rpc_modules": 5,
    "nullrpc_getCapabilities": 5,
    "eth_syncing": 5,
    "eth_accounts": 5,

    "eth_blockNumber": 10,
    "eth_gasPrice": 10,
    "eth_maxPriorityFeePerGas": 10,

    "eth_getBalance": 15,
    "eth_getTransactionCount": 15,
    "eth_getCode": 15,
    "eth_getStorageAt": 15,
    "eth_getTransactionByHash": 15,
    "eth_getTransactionReceipt": 15,
    "eth_getTransactionByBlockNumberAndIndex": 15,
    "eth_getTransactionByBlockHashAndIndex": 15,
    "eth_getRawTransactionByHash": 15,
    "eth_getRawTransactionByBlockNumberAndIndex": 15,
    "eth_getRawTransactionByBlockHashAndIndex": 15,
    "eth_getBlockTransactionCountByNumber": 15,
    "eth_getBlockTransactionCountByHash": 15,
    "eth_getUncleCountByBlockNumber": 15,
    "eth_getUncleCountByBlockHash": 15,
    "eth_getUncleByBlockNumberAndIndex": 15,
    "eth_getUncleByBlockHashAndIndex": 15,
    "debug_getRawHeader": 15,
    "debug_getRawTransaction": 15,
    "debug_codeByHash": 15,
    "debug_chainConfig": 15,

    "eth_getBlockByNumber": 20,
    "eth_getBlockByHash": 20,
    "eth_feeHistory": 20,
    "debug_getRawBlock": 20,
    "debug_getRawTransactions": 20,

    "eth_getBlockReceipts": 30,
    "debug_getRawReceipts": 30,
    "eth_call": 30,
    "eth_sendRawTransaction": 30,

    "eth_estimateGas": 50,

    "debug_traceTransaction": 40,
    "debug_traceCall": 40,
    "debug_traceBlockByNumber": 40,
    "debug_traceBlockByHash": 40,
    "debug_traceBlock": 40,
    "trace_transaction": 40,
    "trace_block": 40,
    "trace_call": 40,
    "trace_callMany": 40,
    "trace_rawTransaction": 40,
    "trace_get": 40,
    "trace_filter": 40,
    "trace_replayTransaction": 80,
    "trace_replayBlockTransactions": 80
  },
  "ranges": {
    "_comment": "Range-priced methods: credits = base for up to base_blocks, plus per_step for each started step beyond; blocks = toBlock - fromBlock + 1 (a blockHash filter is one block). The RPC Worker refuses ranges above max_blocks (-32005).",
    "eth_getLogs": { "base": 50, "base_blocks": 1000, "step": 1000, "per_step": 5, "max_blocks": 10000 }
  }
}
