// The nullrpc landing page at https://nullrpc.dev; www redirects to the apex.
//
// Usage charts need a secret once: bunx wrangler secret put CF_ANALYTICS_TOKEN
// (an API token with "Account Analytics: Read").
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nullrpc-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "nullrpc.dev", "custom_domain": true },
    { "pattern": "www.nullrpc.dev", "custom_domain": true }
  ],
  // The Worker runs first for every request: www redirect, method check, /api/*, security headers.
  // Runtime configuration: the networks list (apps/networks.ts; `bun run networks:push` updates it).
  "kv_namespaces": [{ "binding": "CONFIG", "id": "41505b2a2056481a82b012c92c9f841f" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
